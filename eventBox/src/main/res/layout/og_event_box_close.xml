<?xml version="1.0" encoding="utf-8"?>
<!--
    The drop-to-close target (testing only, see OGEventBoxLog).
    It lives in its own window, added at the bottom of the screen only while a drag comes near it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/og_event_box_close_target"
        android:layout_width="@dimen/og_event_box_close_size"
        android:layout_height="@dimen/og_event_box_close_size"
        android:layout_gravity="center"
        android:background="@drawable/og_event_box_close_background"
        android:contentDescription="@string/og_event_box_close"
        android:padding="14dp"
        android:src="@drawable/og_event_box_ic_close"
        android:tint="@color/og_event_box_on_accent" />
</FrameLayout>
