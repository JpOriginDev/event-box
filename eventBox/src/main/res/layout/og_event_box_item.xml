<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the OGEventBox list (RecyclerView item). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/og_event_box_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    tools:background="@color/og_event_box_surface">

    <LinearLayout
        android:id="@+id/og_event_box_item_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:longClickable="true"
        android:minHeight="24dp"
        android:orientation="horizontal">

        <!-- Kind of entry at a glance: amber = warning, blue = user property, none = event. -->
        <View
            android:id="@+id/og_event_box_item_stripe"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/og_event_box_stripe_background"
            android:importantForAccessibility="no"
            android:visibility="invisible"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/og_event_box_item_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:textColor="@color/og_event_box_name"
            android:textSize="12sp"
            tools:text="01  14:55:00 +1.2s  main_activity_created" />

        <TextView
            android:id="@+id/og_event_box_item_repeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/og_event_box_repeat_background"
            android:importantForAccessibility="no"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:textColor="@color/og_event_box_on_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="×3"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/og_event_box_item_warning"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="16dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/og_event_box_warning_description"
            android:focusable="true"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/og_event_box_ic_warning"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/og_event_box_item_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/og_event_box_warning_background"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/og_event_box_item_warning_event_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/og_event_box_name"
            android:textIsSelectable="false"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Event: event_box_enabled_via_consecutive_clicks" />

        <TextView
            android:id="@+id/og_event_box_item_params_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/og_event_box_params_title"
            android:textColor="@color/og_event_box_time"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Key/value table: monospace with padded keys, value type tag at the end. -->
        <TextView
            android:id="@+id/og_event_box_item_params_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/og_event_box_name"
            android:textSize="11sp"
            tools:text="  place  : splash_open  S\n  action : request      S" />

        <TextView
            android:id="@+id/og_event_box_item_warning_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/og_event_box_warning_title"
            android:textColor="@color/og_event_box_warning"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/og_event_box_item_warning_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/og_event_box_warning_text"
            android:textSize="11sp"
            tools:text="• Event name exceeds 40 characters (41 chars)." />
    </LinearLayout>

    <!-- Item divider between event rows -->
    <View
        android:id="@+id/og_event_box_item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginEnd="16dp"
        android:background="@color/og_event_box_divider" />
</LinearLayout>
